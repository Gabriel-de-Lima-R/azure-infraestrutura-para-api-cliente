.vscode/
!.vscode/extensions.json
!.vscode/tasks.json

# Logs e diagnósticos locais
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Sistema Operacional ---
.DS_Store
Thumbs.db